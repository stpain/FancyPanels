    <Font name="FancyPanelsSpellNameFont" font="Fonts\FRIZQT__.TTF" virtual="true">
		<Color color="SPELLBOOK_FONT_COLOR"/>
        <FontHeight val="15"/>
	</Font>

    <Frame name="FancyPanelsSpellbookSpellItem" mixin="FancyPanelsSpellbookSpellItemMixin" enableMouseMotion="true" enableMouse="true" virtual="true">
        <Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Backplate" alpha="0.33" file="Interface\AddOns\FancyPanels\Media\SpellbookElements.png">
					<Anchors>
						<Anchor point="TOPLEFT" x="5" y="-5"/>
						<Anchor point="BOTTOMRIGHT" x="-5" y="5"/>
					</Anchors>
				</Texture>
			</Layer>
        </Layers>
        <Size x="190" y="60"/>
        <Frames>
			<Frame parentKey="TextContainer" inherits="ResizeLayoutFrame">
				<!--Height Adjusted Dynamically in UpdateVisuals-->
				<Size y="1"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="46" y="-10"/>
					<Anchor point="RIGHT" y="-1"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Name" inherits="FancyPanelsSpellNameFont" justifyH="LEFT" maxLines="2" wordwrap="true">
                            <Anchors>
								<Anchor point="TOPLEFT"/>
							</Anchors>
							<Color color="SPELLBOOK_FONT_COLOR" />
                            <Size x="135"/>
						</FontString>
						<FontString parentKey="SubName" inherits="SystemFont_Med1" justifyH="LEFT" maxLines="1" wordwrap="true">
							<Anchors>
								<Anchor point="TOPLEFT" relativeKey="$parent.Name" relativePoint="BOTTOMLEFT" x="0" y="-2"/>
								<Anchor point="TOPRIGHT" relativeKey="$parent.Name" relativePoint="BOTTOMRIGHT" x="0" y="-2"/>
							</Anchors>
							<Color color="SPELLBOOK_FONT_COLOR" />
						</FontString>
					</Layer>
				</Layers>
			</Frame>

            <Button parentKey="Button" registerForClicks="anyDown" enableMouseMotion="true" enableMouse="true" enableKeyboard="true" enableMouseClicks="true">
				<Size x="40" y="40"/>
				<Anchors>
					<Anchor point="LEFT"/>
				</Anchors>

                <Layers>
					<Layer level="ARTWORK" textureSubLevel="-1">
						<Texture parentKey="Icon">
                            <!-- <TexCoords left="0.01" right="0.99" top="0.01" bottom="0.99"/> -->
							<Size x="30" y="30"/>
							<Anchors>
								<Anchor point="CENTER" x="4" y="2"/>
							</Anchors>
						</Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <MaskTexture parentKey="mask" file="Interface\AddOns\FancyPanels\Media\Talents\CommonIconMask.png" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
							<Size x="28" y="28"/>
							<Anchors>
								<Anchor point="CENTER" x="4" y="2"/>
							</Anchors>
                            <MaskedTextures>
                                <MaskedTexture childKey="Icon"/>
                            </MaskedTextures>
                        </MaskTexture>
					</Layer>
					<Layer level="OVERLAY" textureSubLevel="1">
						<Texture parentKey="Border" setAllPoints="true" texelSnappingBias="0.0" snapToPixelGrid="false" file="Interface\AddOns\FancyPanels\Media\SpellbookElements.png"/>
					</Layer>
					<Layer level="BACKGROUND" textureSubLevel="-1">
						<Texture parentKey="IconHighlight" hidden="true" texelSnappingBias="0.0" snapToPixelGrid="false" file="Interface\AddOns\FancyPanels\Media\Talents\Talents.png">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="-14" y="20"/>
                                <Anchor point="BOTTOMRIGHT" x="22" y="-16"/>
                            </Anchors>
                        </Texture>
					</Layer>
                </Layers>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnLeave method="OnLeave"/>
            <OnEnter method="OnEnter"/>
        </Scripts>
    </Frame>

